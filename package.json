{
  "name": "acsp-web",
  "version": "1.0.0",
  "description": "A web application for the Authorized Corporate Service Providers (ACSP)",
  "main": "dist/src/server.js",
  "engines": {
    "node": "24.11.0"
  },
  "scripts": {
    "prebuild": "rm -rf ./dist",
    "build:assets": "node scripts/build-assets.js",
    "build:server": "tsc && cp -r src/views dist/src",
    "build": "npm run build:assets && npm run build:server",
    "lint": "eslint 'src/**/*.ts' 'test/src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'test/src/**/*.ts' --fix",
    "test:coverage": "node --expose-gc ./node_modules/.bin/jest --logHeapUsage --coverage --passWithNoTests --coverageProvider=v8",
    "test": "node --expose-gc ./node_modules/.bin/jest --logHeapUsage",
    "start": "npm run build && node dist/src/server.js",
    "start:watch": "nodemon",
    "sonarqube-base-branch": "sonar-scanner",
    "sonarqube-pull-request": "sonar-scanner -D sonar.pullrequest.base=main",
    "sonarqube": "branch=$(git rev-parse --symbolic-full-name --abbrev-ref HEAD); if [[ $branch == \"HEAD\" ]]; then echo $branch && npm run sonarqube-base-branch; else echo $branch && npm run sonarqube-pull-request; fi;",
    "chs-dev": "nodemon --legacy-watch",
    "prepare": "husky install"
  },
  "license": "MIT",
  "dependencies": {
    "@companieshouse/api-sdk-node": "2.0.351",
    "@companieshouse/ch-node-utils": "3.0.7",
    "@companieshouse/node-session-handler": "5.2.15",
    "@companieshouse/structured-logging-node": "2.0.15",
    "@companieshouse/web-security-node": "4.4.21",
    "axios": "1.20.0",
    "cookie-parser": "1.4.7",
    "express": "4.22.1",
    "express-validator": "6.14.0",
    "govuk_frontend_toolkit": "9.0.1",
    "govuk-elements-sass": "3.1.3",
    "govuk-frontend": "6.0.0",
    "helmet": "8.0.0",
    "http-errors": "1.7.3",
    "ioredis": "4.28.5",
    "js-yaml": "4.3.2",
    "nocache": "4.0.0",
    "node-mocks-http": "1.12.2",
    "nunjucks": "3.2.4",
    "private-api-sdk-node": "github:companieshouse/private-api-sdk-node#1.0.113",
    "tslib": "2.8.1",
    "uuid": "11.1.1",
    "yargs": "15.3.1"
  },
  "devDependencies": {
    "@types/cheerio": "0.22.18",
    "@types/cookie-parser": "1.4.3",
    "@types/express": "4.17.6",
    "@types/http-errors": "1.6.3",
    "@types/ioredis": "4.14.9",
    "@types/jest": "30.0.0",
    "@types/js-yaml": "3.12.5",
    "@types/node": "12.7.8",
    "@types/nunjucks": "3.1.2",
    "@types/supertest": "2.0.16",
    "@types/uuid": "7.0.3",
    "@stylistic/eslint-plugin": "^5.9.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@eslint/js": "^10.0.1",
    "cheerio": "1.2.0",
    "eslint": "10.0.2",
    "globals": "^17.3.0",
    "http-status-codes": "2.3.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "nock": "12.0.3",
    "nodemon": "3.1.14",
    "sass": "1.97.3",
    "supertest": "7.2.2",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "4.9.5",
    "uglify-js": "3.19.3"
  },
  "@comments devDependencies": {
    "@package sass": [
      "We're using an older version of @sass to suppress deprecation warnings thrown by the @govuk-frontend package during the build",
      "We'll upgrade to the most recent version of @sass after this issue is fixed in the @govuk-frontend package"
    ],
    "@package nodemon": [
      "chokidar is overridden to 4.x because chokidar 3.x depends on braces, which has an unpatched high severity vulnerability (GHSA-vfj7-8cjw-p6xm)",
      "nodemon always passes interval: pollingInterval to chokidar; when unset this is undefined, which overrides chokidar 4's default (chokidar 3 restored it), so pollingInterval must be set in nodemon.json and nodemonConfig for --legacy-watch (used by chs-dev) to work",
      "Remove the chokidar override and pollingInterval once nodemon depends on a chokidar version without braces"
    ]
  },
  "overrides": {
    "chokidar": "4.0.3",
    "glob-parent": "6.0.2",
    "js-yaml": "4.3.2",
    "@babel/core": "8.0.0",
    "shell-quote": "1.8.4",
    "qs": "6.16.1",
    "i18next-fs-backend": "2.6.6",
    "form-data": "4.0.6",
    "brace-expansion": "5.0.12",
    "follow-redirects": "1.16.1"
  },
  "nodemonConfig": {
    "watch": [
      "./src",
      "./assets/src"
    ],
    "ext": "ts,js,json,njk,scss,env",
    "legacyWatch": true,
    "pollingInterval": 100,
    "ignore": [
      "**/*.test.ts"
    ],
    "exec": "npm run build && node dist/src/server.js"
  },
  "directories": {
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/companieshouse/acsp-web.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/companieshouse/acsp-web/issues"
  },
  "homepage": "https://github.com/companieshouse/acsp-web#readme"
}
